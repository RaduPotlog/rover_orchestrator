<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_navigation</name>
  <version>1.0.0</version>
  <description>The package contains the nav2 package configurations of the rover</description>
  <maintainer email="potlogradu@gmail.com">root</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>behaviortree_cpp</depend>
  <depend>diagnostic_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>nav2_msgs</depend>
  <!-- nav2::LifecycleNode, the type bt_navigator puts on the BT blackboard. -->
  <depend>nav2_ros_common</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <!-- Imported by every file under launch/. -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Nav 2 servers spawned by launch/rover_nav.launch.py, launch/localization.launch.py
       and launch/slam_launch.py, plus the plugins config/rover_nav_params.yaml loads.
       Runtime-only (no headers are compiled against them), hence exec_depend. -->
  <!-- localization.launch.py, with localization_source:=amcl. -->
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <!-- Every launch file imports nav2_common.launch (ReplaceString / RewrittenYaml). -->
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <!-- planner_server's GridBased plugin. -->
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <!-- Self-filter for the pointcloud path. Source-only; pinned in
       rover_autonomy/autonomy_deps.repos. The repo is rover_pointcloud_crop_box, the
       package inside it is pointcloud_crop_box. -->
  <exec_depend>pointcloud_crop_box</exec_depend>
  <!-- bringup.launch.py spawns component_container_isolated as nav2_container
       (use_composition defaults to True). -->
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <!-- Both costmaps' stvl_layer; pluginlib loads it by name from config/rover_nav_params.yaml. -->
  <exec_depend>spatio_temporal_voxel_layer</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
