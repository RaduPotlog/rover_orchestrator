# External sources the orchestrator-computer autonomy stack needs but that are not available
# as binary packages.
#
# Everything rover_autonomy needs is either a binary ROS 2 package (every nav2_* package
# including nav2_smac_planner, which now has an arm64 deb on lyrical/resolute, slam_toolbox,
# behaviortree_cpp, spatio_temporal_voxel_layer, pointcloud_to_laserscan) or already in this
# workspace (rover_ros). In particular, BehaviorTree.ROS2 is NOT vendored: rover_mission_manager
# dispatches Nav 2 actions through nav2_behavior_tree's BtActionNode, which ships with Nav 2, so
# there is no source dependency to pin.
#
# Nothing is pinned today; add a source-only dependency here and the orchestrator image
# build imports it.
repositories: {}
