# External sources the orchestrator-computer autonomy stack needs but that are not available
# as binary packages.
#
# Everything else rover_autonomy needs is either a binary ROS 2 package (nav2_*, slam_toolbox,
# behaviortree_cpp, spatio_temporal_voxel_layer, pointcloud_to_laserscan) or already in this
# workspace (rover_ros). In particular, BehaviorTree.ROS2 is NOT vendored: rover_mission_manager
# dispatches Nav 2 actions through nav2_behavior_tree's BtActionNode, which ships with Nav 2, so
# there is no source dependency to pin.
repositories:
  # Self-filter for rover_navigation's pointcloud path: crops the rover's own body out of
  # <namespace>/rslidar_points before the costmaps see it, producing
  # <observation_topic>_filtered for the stvl_layer's `pointcloud` source.
  #
  # Only needed with `observation_topic_type:=pointcloud`; the default laserscan path consumes
  # rover_lidar's <namespace>/scan directly. Note the repository is rover_pointcloud_crop_box
  # but the package inside it is `pointcloud_crop_box` - that is the name in package.xml and in
  # bringup.launch.py.
  rover_pointcloud_crop_box:
    type: git
    url: https://github.com/RaduPotlog/rover_pointcloud_crop_box.git
    version: master

  # nav2_smac_planner: planner_server's GridBased plugin
  # (config/rover_nav_params.yaml -> nav2_smac_planner::SmacPlanner2D).
  #
  # Every other nav2_* package this stack needs has an arm64 binary on lyrical/resolute;
  # nav2_smac_planner is the single exception - it is absent from the sync, so it has to
  # be built from source. The tag below matches the installed ros-lyrical-nav2-* debs
  # (1.5.1) exactly, so headers and ABI line up.
  #
  # vcstool cannot express a sparse checkout, and a full `vcs import` of this entry would
  # put ~40 navigation2 packages in the build, shadowing the debs. After importing, prune
  # it down to the one package we actually build:
  #
  #   git -C src/third_party/navigation2 sparse-checkout init --cone
  #   git -C src/third_party/navigation2 sparse-checkout set nav2_smac_planner
  #
  # Build dep not covered by the debs: ros-lyrical-ompl.
  navigation2:
    type: git
    url: https://github.com/ros-navigation/navigation2.git
    version: 1.5.1
